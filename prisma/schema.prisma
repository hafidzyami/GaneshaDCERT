generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VCIssuanceRequest {
  id             String        @id @default(uuid())
  issuer_did     String
  holder_did     String
  status         RequestStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  encrypted_body String
  vc_id          String?
}

model VCRenewalRequest {
  id             String        @id @default(uuid())
  issuer_did     String
  holder_did     String
  status         RequestStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  encrypted_body String
  vc_id          String?
}

model VCUpdateRequest {
  id             String        @id @default(uuid())
  issuer_did     String
  holder_did     String
  status         RequestStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  encrypted_body String
  vc_id          String?
}

model VCRevokeRequest {
  id             String        @id @default(uuid())
  issuer_did     String
  holder_did     String
  status         RequestStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  encrypted_body String
  vc_id          String?
}

model IssuerActionLog {
  id               String      @id @default(uuid())
  action_type      RequestType
  issuer_did       String
  holder_did       String?
  vc_id            String
  new_vc_id        String?
  transaction_hash String?
  createdAt        DateTime    @default(now())

  @@index([issuer_did])
  @@index([holder_did])
  @@index([action_type])
}

model VPSharing {
  id           String    @id @default(uuid())
  holder_did   String
  VP           String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  is_barcode   Boolean   @default(false)
  hasClaim     Boolean   @default(false)
  verifier_did String?

  @@index([verifier_did])
  @@index([hasClaim])
}

model VCResponse {
  id             String           @id @default(uuid())
  request_id     String           @default(uuid())
  request_type   RequestType
  issuer_did     String
  holder_did     String
  order_id       String           @default(uuid())
  encrypted_body String
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?
  status         VCResponseStatus @default(PENDING)
  updatedAt      DateTime         @default(now()) @updatedAt
  processing_at  DateTime?
  vc_hash        String?
  claimable      Boolean          @default(false)

  @@index([order_id])
  @@index([claimable])
}

model Order {
  id                String        @id @default(uuid())
  payment_method_id String        @default(uuid())
  payment_payload   Json
  VCs_id            String[]      @default(uuid())
  schemas_id        String[]
  request_type      RequestType
  holder_did        String
  issuer_did        String
  payment_status    PaymentStatus @default(UNPAID)
  product_fee       Decimal
  service_fee       Decimal
  total_fee         Decimal
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
}

model PaymentMethod {
  id               String    @id @default(uuid())
  type             String
  group            String
  name             String
  bank_code        String
  sender_bank_type String
  description      String
  deadline         Int
  icon             String
  availability     Boolean   @default(false)
  fee_fixed        Decimal
  fee_percent      Decimal
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
}

model InstitutionRegistration {
  id         String        @id @default(uuid())
  email      String        @unique
  name       String
  phone      String
  country    String
  website    String
  address    String
  status     RequestStatus @default(PENDING)
  approvedAt DateTime?
  approvedBy String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  magicLinks MagicLink[]
}

model VCSchema {
  id             String         @default(uuid())
  name           String
  schema         Json
  issuer_did     String
  version        Int            @default(1)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  issuer_name    String?
  image_link     String?
  expired_in     Int?
  VCSchemaPrices VCSchemaPrice?

  @@id([id, version])
  @@index([id])
  @@index([version])
  @@index([isActive])
}

model MagicLink {
  id            String                  @id @default(uuid())
  institutionId String
  token         String                  @unique
  expiresAt     DateTime
  used          Boolean                 @default(false)
  usedAt        DateTime?
  createdAt     DateTime                @default(now())
  institution   InstitutionRegistration @relation(fields: [institutionId], references: [id])

  @@index([token])
  @@index([institutionId])
}

model VPRequest {
  id                    String          @id @default(uuid())
  holder_did            String
  verifier_did          String
  createdAt             DateTime        @default(now())
  purpose               String
  requested_credentials Json
  status                VPRequestStatus @default(PENDING)
  updatedAt             DateTime        @updatedAt
  verifier_name         String
  verify_status         VPVerifyStatus  @default(NOT_VERIFIED)
  vp_id                 String?
  credentials           Json?

  @@index([holder_did])
  @@index([verifier_did])
  @@index([status])
  @@index([vp_id])
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushToken {
  id         String   @id @default(uuid())
  holder_did String
  token      String   @unique
  deviceInfo Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([holder_did])
  @@index([token])
}

model Institution {
  id         String    @id @default(uuid())
  did        String    @unique
  email      String    @unique
  name       String
  phone      String
  country    String
  website    String
  address    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastActive DateTime?
}

model VCinitiatedByIssuer {
  id             String           @id @default(uuid())
  request_type   RequestType
  issuer_did     String
  holder_did     String
  encrypted_body String
  status         VCResponseStatus @default(PENDING)
  processing_at  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  vc_id          String?
  order_id       String?
  claimable      Boolean          @default(false)

  @@index([vc_id])
  @@index([order_id])
  @@index([claimable])
}

model IssuerVCData {
  issuer_did     String
  encrypted_body String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  id             String   @id @default(uuid())
  holder_did     String?
  vc_id          String?

  @@index([issuer_did])
  @@index([holder_did])
  @@index([vc_id])
}

model VCSchemaPrice {
  schemaId  String
  price     Decimal
  currency  String
  version   Int      @default(1)
  updatedAt DateTime @default(now())
  VCSchema  VCSchema @relation(fields: [schemaId, version], references: [id, version])

  @@id([schemaId, version])
  @@index([schemaId])
}

model EventCheckpoint {
  id              String   @id @default(uuid())
  contractAddress String
  eventType       String
  lastSyncedBlock BigInt
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([contractAddress, eventType])
  @@index([contractAddress])
  @@index([eventType])
}

model ProcessedEvent {
  id              String   @id @default(uuid())
  transactionHash String
  logIndex        Int
  eventType       String
  contractAddress String
  blockNumber     BigInt
  processedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([transactionHash, logIndex])
  @@index([transactionHash])
  @@index([eventType])
  @@index([blockNumber])
}

model CredentialHistoryBlockchain {
  id          String        @id
  issuerDID   String
  holderDID   String
  historyType String
  status      HistoryStatus
  vcID        String
  newVCID     String?
  blockNumber BigInt
  txHash      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([issuerDID])
  @@index([holderDID])
  @@index([status])
  @@index([vcID])
  @@index([txHash])
}

model OrderBlockchain {
  id          String                @id
  holderDID   String
  status      BlockchainOrderStatus
  amount      BigInt
  currency    String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  blockNumber BigInt
  txHash      String

  @@index([holderDID])
  @@index([status])
  @@index([txHash])
}

model ItemBlockchain {
  id          String   @id
  price       BigInt
  vcID        String
  vcHash      String
  itemType    ItemType
  isPaid      Boolean  @default(false)
  blockNumber BigInt
  txHash      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  holderDID   String   @default("")
  issuerDID   String   @default("")

  @@index([vcID])
  @@index([issuerDID])
  @@index([holderDID])
  @@index([isPaid])
  @@index([txHash])
}

model PaymentBlockchain {
  id          String   @id
  orderID     String
  method      String
  status      String
  amount      BigInt
  paidAt      BigInt?
  blockNumber BigInt
  txHash      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderID])
  @@index([status])
  @@index([txHash])
}

model BlockchainTransaction {
  id          String                      @id @default(uuid())
  type        BlockchainTransactionType
  status      BlockchainTransactionStatus @default(PENDING)
  payload     String
  txHash      String?
  blockNumber BigInt?
  error       String?
  retryCount  Int                         @default(0)
  maxRetries  Int                         @default(3)
  createdAt   DateTime                    @default(now())
  processedAt DateTime?
  confirmedAt DateTime?
  failedAt    DateTime?
  updatedAt   DateTime                    @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestType {
  ISSUANCE
  RENEWAL
  UPDATE
  REVOKE
}

enum PaymentStatus {
  UNPAID
  PAID
  CANCELED
}

enum VCResponseStatus {
  PENDING
  PROCESSING
  CLAIMED
}

enum VPRequestStatus {
  PENDING
  ACCEPT
  DECLINE
}

enum VPVerifyStatus {
  NOT_VERIFIED
  VALID_VERIFICATION
  INVALID_VERIFICATION
}

enum HistoryStatus {
  NONE
  INITIATED
  PENDING
  APPROVED
  REJECTED
}

enum BlockchainOrderStatus {
  NONE
  PENDING_PAYMENT
  SUCCESS
  CANCELED
}

enum ItemType {
  ISSUANCE
  RENEWAL
  UPDATE
}

enum BlockchainTransactionStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
}

enum BlockchainTransactionType {
  CREATE_ITEM
  CREATE_ORDER
  CREATE_PAYMENT
  COMPLETE_PAYMENT
  FAILED_PAYMENT
  UPDATE_ORDER_STATUS
  UPDATE_PAYMENT_STATUS
  MARK_ITEM_AS_PAID
}

// ============================================
// SELECTIVE DISCLOSURE (ZKP) MODELS
// ============================================

model SelectiveDisclosureRequest {
  id                   String                       @id @default(uuid())
  holderDID            String
  verifierDID          String
  verifierName         String
  credentialTypes      String[]
  purpose              String
  challenge            String                       @unique
  domain               String
  expiresAt            DateTime
  requestedAttributes  String?                      // JSON: RequestedAttribute[]
  requestedPredicates  String?                      // JSON: RequestedPredicate[]
  status               SelectiveDisclosureStatus    @default(PENDING)
  verifyStatus         VPVerifyStatus               @default(NOT_VERIFIED)
  vpId                 String?
  verifiedAt           DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  // Relations
  vp                   SelectiveDisclosureVP?

  @@index([holderDID])
  @@index([verifierDID])
  @@index([status])
  @@index([challenge])
  @@index([expiresAt])
}

model SelectiveDisclosureVP {
  id                  String                       @id @default(uuid())
  requestId           String                       @unique
  holderDID           String
  verifierDID         String
  vpData              String                       // JSON: SelectiveDisclosureVP
  revealedAttributes  String?                      // JSON: RevealedAttribute[]
  predicateResults    String?                      // JSON: PredicateProofResult[]
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  // Relations
  request             SelectiveDisclosureRequest   @relation(fields: [requestId], references: [id])

  @@index([holderDID])
  @@index([verifierDID])
  @@index([requestId])
}

enum SelectiveDisclosureStatus {
  PENDING
  ACCEPT
  DECLINE
  EXPIRED
}
