{
  "name": "ganeshadcert",
  "version": "2.0.0",
  "description": "API GaneshaDCERT dengan RabbitMQ Integration",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:cache": "jest --testPathPatterns=cache.service.test.ts",
    "test:lock": "jest --testPathPatterns=distributedLock.service.test.ts",
    "test:auto-delete": "ts-node src/tests/auto-delete.test.ts",
    "test:auto-delete:quick": "ts-node src/tests/auto-delete.quick.test.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "create-admin": "ts-node scripts/createAdmin.ts",
    "reset-admin-password": "ts-node scripts/resetAdminPassword.ts",
    "rabbitmq:start": "docker-compose -f docker-compose.yml up -d",
    "rabbitmq:stop": "docker-compose -f docker-compose.yml down",
    "rabbitmq:restart": "docker-compose -f docker-compose.yml restart",
    "rabbitmq:logs": "docker-compose -f docker-compose.yml logs -f",
    "rabbitmq:status": "docker-compose -f docker-compose.yml ps",
    "rabbitmq:clean": "docker-compose -f docker-compose.yml down -v"
  },
  "keywords": [
    "api",
    "swagger",
    "typescript",
    "express",
    "rabbitmq",
    "message-queue",
    "verifiable-credentials"
  ],
  "author": "Hafidz Yami",
  "license": "ISC",
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@prisma/client": "^6.17.0",
    "@types/node-cron": "^3.0.11",
    "amqplib": "^0.10.9",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "ethers": "^6.15.0",
    "expo-server-sdk": "^3.15.0",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.6",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.9",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/bull": "^3.15.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/minio": "^7.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.17.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
